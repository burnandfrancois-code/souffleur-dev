{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nom complet du demandeur"
    },
    "email": {
      "type": "string",
      "description": "Email du demandeur"
    },
    "message": {
      "type": "string",
      "description": "Message ou raison de la demande"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Statut de la demande"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}